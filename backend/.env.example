# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CORS Settings (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (Defaults to local SQLite; uncomment and set DATABASE_URL if using managed PostgreSQL/MySQL)
DJANGO_DB_NAME=db.sqlite3
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Static Files (Production collectstatic destination directory)
DJANGO_STATIC_ROOT=staticfiles

# Mapbox API Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here


